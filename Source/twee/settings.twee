:: Setting DolOptimization [widget]

<<widget "doloptimizationModTab">>
	<<button 原版优化>>
		<<toggleTab>>
		<<replace #customOverlayContent>><<doloptimizationModSetting>><</replace>>
	<</button>>
<</widget>>

<<widget "doloptimizationModSetting">>
	<<setupOptions>>
	<div class="p-2 text-align-center">
		<h3>原版优化 <<print window.modSC2DataManager?.getModLoader()?.getModZip("原版优化")?.modInfo?.version ?? "未知版本">></h3>
		<div class="m-2">
			<span class="gold">开发者：</span>
			<span>ANLIN.STUDIO</span>
		</div>
		<div class="m-2">
			<p class="gold m-0">Github发布页</p>
			<a target="_blank" class="link-external" href="https://github.com/ANLINSTUDIO/Degrees-of-Lewdity-DolOptimization" tabindex="0">Github /ANLINSTUDIO/Degrees-of-Lewdity-DolOptimization</a>
		</div>
		<div class="m-2">
			<p class="gold m-0">最新版本下载链接</p>
			<a target="_blank" class="link-external" href="https://sb.alseece.top/2?=Dol-Optimization" tabindex="0" 
			data-remote="https://sb.alseece.top/2/value.php?key=DoL-Optimization-LastestVersion"
			data-replace="true">正在获取最新版本……</a>
			<div style="text-align: start;" 
			data-remote="https://sb.alseece.top/2/value.php?key=DoL-Optimization-Notice"
			data-replace="true">正在获取公告</div>
			<<run AsAPI.loadRemote()>>
		</div>
		<div class="m-2">
			<p class="gold m-0">百度贴吧发布帖</p>
			<a target="_blank" class="link-external" href="https://tieba.baidu.com/p/10567790315?fr=personpage" tabindex="0">原版优化 |关于原版的小优化</a>
		</div>
	</div>
	<<run DolOptimization.rv()>>
	<div class="settingsGrid">
		<div class="optimization">
			“打开/关闭导航栏”的黑块箭头: 
			<br>
			<label><<radiovar "$options.opt.UiBarToggle" "default">><<run DolOptimization.applySettings()>><</radiovar>> 默认</label> |
			<label><<radiovar "$options.opt.UiBarToggle" "back">><<run DolOptimization.applySettings()>><</radiovar>> 回溯</label> |
			<label><<radiovar "$options.opt.UiBarToggle" "hide">><<run DolOptimization.applySettings()>><</radiovar>> 隐藏</label>

			<img src="guide/“打开关闭导航栏”的黑块箭头.png">
			<div class="alist">
				<a target="_blank" class="link-external" href='https://tieba.baidu.com/home/main?id=tb.1.b040b4ea.W-Ia-FiFJRnpGK2yEvLkxg%3Ft%3D1773825545&fr=pb' tabindex="0">「離地三尺一條河」</a>
				<a target="_blank" class="link-external" href='https://tieba.baidu.com/home/main?id=tb.1.4515509a.HMRwrMmE3gOEM7NFLLQNbg%3Ft%3D1778597577&fr=pb' tabindex="0">「◆冬至蝉鸣◆」</a>
			</div>
			<br>
			<span class="red">注意，这在PC端上尤其要小心开启：PC上无法通过向右滑动来展开侧边栏！必要时你可以通过本模组定义的<span class="purple">鼠标滚轮中键</span>来切换侧边栏。</span>
		</div>
		<div class="optimization">
			<div id="custom-font-text" style="word-break: break-all;"><<print DolOptimization.Current_Font ?? "自定义字体">></div>
			<input type="file" id="custom-font" name="custom-font" onchange="DolOptimization.loadCustomFont()" style="width: stretch;">
			<br>
			<input type="button" value="取消设置" onclick='DolOptimization.unsetCustomFont()'>
			&nbsp;&nbsp;
			<label>
				<<if $passage is "Start">>
					<<print '<input type="checkbox" tabindex="0" id="checkbox-optimizationcustomfontglobal" class="macro-checkbox" checked disabled>'>>
				<<else>>
					<<print '<input type="checkbox" tabindex="0" id="checkbox-optimizationcustomfontglobal" class="macro-checkbox" onchange="DolOptimization.checkOptimizationCustomFontGlobal(this.checked)"'+(V.options.DolOptimization?.OptimizationCustomFontGlobal? " checked": "")+'>'>>
				<</if>>
				应用到全局<<if $passage is "Start">><span class="tooltip-anchor linkBlue" tooltip="在首页时，应用到全局会被锁定">(?)</span><</if>>
			</label>
			<img src="guide/自定义字体.png">
			<a target="_blank" class="link-external" href='https://tieba.baidu.com/home/main?id=tb.1.f77fed2a.NDdy5-IAKW62SdnYGmq04g%3Ft%3D1773829759&fr=pb' tabindex="0">「尼落·忍者」</a>
		</div>
		<div class="optimization"> <<if $passage is 'Start'>><div class="disabled"/><</if>>
			<label>
				<<checkbox "$options.DolOptimization.LargerWardrobe" false true autocheck>>
				衣柜容量自定义 <span class="red">(作弊)</span>
			</label>
			<input type="number" id="largerWardrobeValue" min="1" @value="$options.DolOptimization.LargerWardrobeValue ?? $wardrobe.space" onchange="DolOptimization.largerWardrobe(this)">
			<img src="guide/衣柜容量自定义.png">
		</div>
		<div class='optimization'> <<if $passage is 'Start'>><div class="disabled"/><</if>>
			<label>
				大大大衣柜升级
			</label><br>
			<small>你可以在衣柜处升级你的衣柜空间容量。</small><br>
			<<button [["重置升级等级"|$passage]]>>
				<<unset $options.DolOptimization.LargerWardrobeExpandedValue>>
			<</button>>
			<img src="guide/大大大衣柜升级.png">
		</div>
		<div class='optimization'>
			<label>
				处女膜修复
			</label><br>
			<small>你可以在医院处修复处女膜。</small><br>
			<img src="guide/处女膜修复.png">
		</div>
		<div class="optimization"> <<if $passage is 'Start'>><div class="disabled"/><</if>>
			<label>
				<<checkbox "$options.DolOptimization.WornStacking" false true autocheck>>
				叠加服装部件
			</label><br>
			<span class="red">注意: 功能是实验性。大部分的衣物可能不太支持，目前所知内衣、上装、手饰、手持物品均无法进行叠加。可能造成面板报错，谨慎开启。</span>
			<img src="guide/叠加服装部件.png">
			<div class="alist">
				<a target="_blank" class="link-external" href='https://tieba.baidu.com/home/main?id=tb.1.cd3433f7.YrE8v7vAxsuld1PmIu9_Ww%3Ft%3D1778860911&fr=pb' tabindex="0">「兄弟我仨人」</a>
				<a target="_blank" class="link-external" href='https://tieba.baidu.com/home/main?id=tb.1.c5ee8bec.KPmrsbwyRq56_tdZjH_9Nw%3Ft%3D1778860919&fr=pb' tabindex="0">「小鼹鼠.」</a>
			</div>
		</div>
	</div>
	<!-- <div class="settingsGrid">
		<div class="settingsToggleItem">
			<input type="button" value="浏览器全屏" onclick='DolOptimization.toggleFullScreen()'/>
			&nbsp;&nbsp;
			<label>
				<<checkbox "$options.DolOptimization.AutoFull" false true autocheck>>
				自动全屏
			</label>
		</div>
	</div> -->
	<div style="text-align: center; width: 100%;">如果你也有一些很小的<span class="def">关于原版小优化</span>的建议，可以在<a target="_blank" class="link-external" href="https://tieba.baidu.com/p/10567790315?fr=personpage" tabindex="0">发布贴</a>下面留言。</div>
	<br><br>
<</widget>>
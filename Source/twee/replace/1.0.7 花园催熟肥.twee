			<<if $fertiliserripening is undefined>><<set $fertiliserripening to {current: 0, used: 0}>><</if>>
			<<if  _plantbed.stage isnot 0 and _plantbed.water is 1 and $fertiliserripening.current gte 1 and _plantbed.days lt setup.foodstuff||setup.plants[_plantbed.plant].days and currentSkillValue('tending') gte 400>>  <!-- 0.5.10.12 适配foodstuff -->
				<<capture _plantbed>>
					<<icon "fertiliserripening.png">>
					<<link "施加催熟肥 (0:03)" $passage>>
						<<pass 3>>

						<!-- 加生长进度 -->
						<<set $fertiliserripening.current-->><<set $fertiliserripening.used++>>
						<<set _plantbeddaysmax to setup.foodstuff||setup.plants[_plantbed.plant].days>>  <!-- 0.5.10.12 适配foodstuff -->
						<<for _i to 0; _i < 2; _i++>>
							<<if _plantbed.days lt _plantbeddaysmax>>
								<<set _plantbed.days++>>
								<<if _plantbed.days gte _plantbeddaysmax * ((_plantbed.stage + 1) / 5)>>
									<<set _plantbed.stage += 1>>
								<</if>>
							<<else>>
								<<break>>
							<</if>>
						<</for>>
						<<set _plantbed.water to 0>>

						<!-- 加土壤质量 -->
						<<if _plantbed.qualityvalue is undefined>>
							<<set _plantbed.qualityvalue to 0>>
						<</if>>
						<<if _plantbed.quality + _plantbed.qualityvalue / 10 < 4>>
							<<set _plantbed.qualityvalue += 4>>
							<<if _plantbed.qualityvalue gte 10>>
								<<set _plantbed.quality to Math.clamp(_plantbed.quality+1, 1, 4)>>
								<<set _plantbed.qualityvalue to _plantbed.qualityvalue-10>>
							<</if>>
						<<else>>
							<<set _plantbed.quality to 4>>
							<<set _plantbed.qualityvalue to 0>>
						<</if>>
					<</link>><<gtiredness>><<note "+2生长进度" "green">><<note "+0.4土壤质量" "green">>
				<</capture>>
				<br>
			<</if>>
			<br>

		<</capture>>
		<<set $_i++>>
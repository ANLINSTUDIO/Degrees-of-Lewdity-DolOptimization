				<<if !$options.DolOptimization.WornStacking or ["upper", "under_upper", "hands", "handheld"].includes(_wardrobe_list) or ["strip","towel","large_towel"].includes(_args[1]) or $wardrobeOption isnot "wear" or $worn[_wardrobe_list].index is 0>>
					<<set V[_wear] = _args[1]>>
				<<else>>
					<<set _item to _selectedWardrobe[_wardrobe_list][_args[1]]>>
					<<run $wornStacking[_wardrobe_list].push(clone(_item))>>
					<<set _selectedWardrobe[_wardrobe_list].deleteAt(_args[1])>>
				<</if>>

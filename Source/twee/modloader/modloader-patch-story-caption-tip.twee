					<<overlayReplace "saves">>
				<</button>>
			</div>
            <<if !window.modSC2DataManager?.getModLoader()?.getModZip("ModHub")>>
			    <br><br>
                <<button "<div id='modloader-tip'>Mod管理器</div>">>
                    <<run window.DolOptimization?.openModHubNotice()>>
                <</button>>
            <</if>>

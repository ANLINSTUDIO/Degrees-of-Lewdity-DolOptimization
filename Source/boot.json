    "addonPlugin": [
        {
            "modName": "TweeReplacer",
            "addonName": "TweeReplacerAddon",
            "modVersion": "^1.0.0",
            "params": [
                {
                    "tip": "【1.1.0.6】侧栏模组管理器入口提示",
                    "passage": "StoryCaption",
                    "findRegex": "<<overlayReplace \\\"saves\\\">>\\r?\\n\\s*<</button>>\\r?\\n\\s*</div>",
                    "regexFlag": "g",
                    "replaceFile": "twee/modloader/modloader-patch-story-caption-tip.twee"
                },
                {
                    "tip": "【1.1.0.6】模组管理器入口提示",
                    "passage": "Widgets Clothing Caption",
                    "findString": "\t\t\t<<overlayReplace \"startFeats\">>\n\t\t<</button>>\n\t</div>",
                    "replaceFile": "twee/modloader/modloader-patch-caption-tip.twee"
                },
                {
                    "tip": "设置",
                    "passage": "overlayReplace",
                    "findRegex": "<<optionsinformation>><<\\/replace>>[\\s\\S]*?<<\\/button>>",
                    "regexFlag": "g",
                    "replace": "<<optionsinformation>><</replace>>\n\t\t<</button>><<doloptimizationModTab>>"
                },
                {
                    "tip": "【1.0.3】大大大衣柜升级",
                    "passage": "Widgets Wardrobe",
                    "findString": "__ <i>_selectedWardrobe[_wardrobe_list].length / _selectedWardrobe.space</i>",
                    "replaceFile": "twee/replace/1.0.3 大大大衣柜升级.twee"
                },
                {
                    "tip": "【1.0.4】处女膜修复",
                    "passage": "Hospital Foyer",
                    "findString": "\t\t<<set _aPregnancy to $sexStats.anus.pregnancy>>\n\t\t<<set _vPregnancy to $sexStats.vagina.pregnancy>>",
                    "replaceFile": "twee/replace/1.0.4 医院处女膜修复.twee"
                },
                {
                    "tip": "【1.0.4】处女膜修复 剧烈运动破坏",
                    "passage": "Widgets",
                    "findString": "Weather.BodyTemperature.addActivity(\"physique\")>>",
                    "replaceFile": "twee/replace/1.0.4 剧烈运动破坏修复处女膜.twee"
                },
                {
                    "tip": "【1.0.4】处女膜修复 剧烈运动破坏 日志时效性",
                    "passage": "Widgets Journal",
                    "findString": "\t\t\t<<if $avery_mansion>>/* Is Avery paying for the PC? */",
                    "replaceFile": "twee/replace/1.0.4 处女膜破坏日志时效性.twee"
                },
                {
                    "tip": "【1.0.6】理发店售卖头发",
                    "passage": "Hairdressers",
                    "findString": "|Hairdressers Seat]]>><</link>>",
                    "replaceFile": "twee/replace/1.0.6 理发店售卖头发.twee"
                },
                {
                    "tip": "【1.0.6】发胶降低发质",
                    "passage": "Widgets Mirror",
                    "findString": "<<widget \"hairgelApply\">>",
                    "replaceFile": "twee/replace/1.0.6 发胶降低发质.twee"
                },
                {
                    "tip": "【1.0.6】发质显示",
                    "passage": "Characteristics",
                    "findString": "<<characteristic-text _hairTextConfig>>",
                    "replaceFile": "twee/replace/1.0.6 发质显示.twee"
                },
                {
                    "tip": "【1.0.7】大厅快速查看花园浇水",
                    "passage": "Orphanage",
                    "findString": "|Garden]]>><<pass 1>><</link>>",
                    "replaceFile": "twee/replace/1.0.7 大厅快速查看花园浇水.twee"
                },
                {
                    "tip": "【1.0.7】卧室快速查看花园浇水",
                    "passage": "Bedroom",
                    "findString": "<<print setup.WeatherDescriptions.extremeTemperature()>>",
                    "replaceFile": "twee/replace/1.0.7 卧室快速查看花园浇水.twee"
                },
                {
                    "tip": "【1.0.7】花园查看进度",
                    "passage": "Widgets Tending",
                    "findString": "\t\t\t<<if _plantbed.stage gte 5>>",
                    "replaceFile": "twee/replace/1.0.7 花园查看生长进度.twee"
                },
                {
                    "tip": "【1.0.7】花园催熟肥",
                    "passage": "Widgets Tending",
                    "findString": "\t\t\t<br>\n\n\t\t<</capture>>\n\t\t<<set $_i++>>",
                    "replaceFile": "twee/replace/1.0.7 花园催熟肥.twee"
                },
                {
                    "tip": "【1.0.7】花园催熟肥存有",
                    "passage": "Widgets Tending",
                    "findString": "<<number $fertiliser.current>>",
                    "replaceFile": "twee/replace/1.0.7 花园催熟肥存有.twee"
                },
                {
                    "tip": "【1.0.7】花园施肥和耕种显示土壤质量",
                    "passage": "Widgets Tending",
                    "findString": "\t\t\t\t\t<</if>>\n\t\t\t\t<</link>><<gtiredness>>\n\t\t\t<</capture>>",
                    "replaceFile": "twee/replace/1.0.7 花园施肥和耕种显示土壤质量.twee"
                },

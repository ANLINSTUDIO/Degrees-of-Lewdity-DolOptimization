                    "tip": "【1.0.7】花园自动灌溉机",
                    "passage": "Widgets Tending",
                    "findString": "\t<<set $_i to 0>>",
                    "replaceFile": "twee/replace/1.0.7 花园自动灌溉机.twee"
                },
                {
                    "tip": "【1.0.7】农资店",
                    "passage": "Shopping Centre",
                    "findString": "|Furniture Shop]]>><<pass 1>><</link>>",
                    "replaceFile": "twee/replace/1.0.7 农资店.twee"
                },
                {
                    "tip": "【1.0.7】农资店锁",
                    "passage": "Shopping Centre",
                    "findString": "|Furniture Shop Lock]]>><<pass 1>><</link>>",
                    "replaceFile": "twee/replace/1.0.7 农资店锁.twee"
                },
                {
                    "tip": "【1.0.8】图书馆关门悉尼驱逐",
                    "passage": "School Library",
                    "findString": "<<if Time.schoolDay>>",
                    "replaceFile": "twee/replace/1.0.8 图书馆关门悉尼驱逐.twee"
                },
                {
                    "tip": "【1.0.8】图书馆关门悉尼驱逐 反tag",
                    "passage": "School Library",
                    "findString": "|Hallways]]>><<pass 1>><</link>>",
                    "replace": "|Hallways]]>><<pass 1>><</link>><</if>>"
                },
                {
                    "tip": "【1.0.8】存档优化",
                    "passage": "overlayReplace",
                    "findString": "<<replace #customOverlayContent>><<saves>><</replace>>",
                    "replace": "<<replace #customOverlayContent>><<saves>><</replace>><<run setTimeout(() => window.DolOptimization?.initsave(), DolOptimization.initsavetime??500)>>",
                    "all": true
                },
                {
                    "tip": "【1.0.9】遇欲便利店",
                    "passage": "Domus Street",
                    "findString": "|Orphanage]]>><<pass 1>><</link>>",
                    "replace": "|Orphanage]]>><<pass 1>><</link>>\n\t\t\t<br>\n\t\t\t<<icon 'convenience-store.png'>><<link [[便利店 (0:01)|Conveniencestore]]>><<pass 1>><<unset $phase>><</link>>"
                },
                {
                    "tip": "【1.1.1】可用物品",
                    "passage": "overlayReplace",
                    "findString": "\t\t\t<<toggleTab>>\n\t\t\t<<replace #customOverlayContent>><<journal>><</replace>>",
                    "replaceFile": "twee/replace/1.1.1 可用物品.twee",
                    "all": true
                },
                {
                    "tip": "【1.0.5】叠加服装部件 衣柜",
                    "passage": "Widgets Wardrobe",
                    "findString": "\t\t<<if $worn[_wardrobe_list].name isnot \"naked\">>",
                    "replaceFile": "twee/replace/叠加服装部件衣柜.twee"
                },
                {
                    "tip": "【1.0.5】叠加服装部件 衣柜链接",
                    "passage": "Widgets Wardrobe",
                    "findString": "\t\t\t\t<<set V[_wear] = _args[1]>>",
                    "replaceFile": "twee/replace/叠加服装部件衣柜链接.twee"
                },
                {
                    "tip": "【1.0.6】叠加服装部件 套装保存",
                    "passage": "Widgets Wardrobe",
                    "findString": "\t\t\t\tgenitals: clone($worn.genitals.name),",
                    "replaceFile": "twee/replace/叠加服装部件套装保存.twee"
                },
                {
                    "tip": "【1.0.6】叠加服装部件 套装修改",
                    "passage": "Widgets Outfits",
                    "findString": "\t\t<<set _outfit to $outfit[$wear_outfit]>>",
                    "replaceFile": "twee/replace/叠加服装部件套装修改.twee"
                },
                {
                    "tip": "【1.0.6】叠加服装部件 套装载入",
                    "passage": "Widgets Outfits",
                    "findString": "\t\t<<if $outfit[$wear_outfit].hairStyle>>",
                    "replaceFile": "twee/replace/叠加服装部件套装载入.twee"
                },
                {
                    "tip": "【1.0.7】叠加服装部件 全部脱下",
                    "passage": "Widgets Clothing",
                    "findString": "\t<<set $_location to _args[0]>>\n\t<<for $_slot range setup.clothingLayer.all>>",
                    "replace": "\t<<set $_location to _args[0]>>\n\t<<for $_slot range setup.clothingLayer.all>>\n\t<<run window.DolOptimization?.wornStackingRemoveAll()>>"
                },
                {
                    "tip": "【1.0.7】叠加服装部件 全部脱下",
                    "passage": "Widgets Clothing",
                    "findString": "\t<<set $_location to _args[0]>>\n\t<<for $_slot range setup.clothingLayer.all.except(_args[1])>>",
                    "replace": "\t<<set $_location to _args[0]>>\n\t<<for $_slot range setup.clothingLayer.all.except(_args[1])>>\n\t<<run window.DolOptimization?.wornStackingRemoveAll()>>"
                },
                {
                    "tip": "【1.0.7】叠加服装部件 区域进入脱下",
                    "passage": "Widgets Clothing",
                    "findString": "\t\t<<if $_cursedPrevent isnot true and _strip_restrict isnot 1 and $worn[_undressSlot].cursed isnot 1>>",
                    "replace": "\t\t<<run window.DolOptimization?.wornStackingStore(_args[0])>>\n\t\t<<if $_cursedPrevent isnot true and _strip_restrict isnot 1 and $worn[_undressSlot].cursed isnot 1>>"
                },
                {
                    "tip": "【1.0.7】叠加服装部件 区域脱离装备",
                    "passage": "Widgets Clothing",
                    "findString": "\t<<set _store_temp to _args[0]>>",
                    "replace": "\t<<run window.DolOptimization?.wornStackingRestore(_args[0])>>\n\t<<set _store_temp to _args[0]>>"
                },
                {
                    "tip": "【1.1.1】叠加服装部件 侧栏即时刷新",
                    "passage": "Widgets Wardrobe",
                    "findString": "<<widget \"updatewardrobe\">>",
                    "replace": "<<widget \"updatewardrobe\">>\n\t<<run window.DolOptimization?.wornStackingApplyStats()>>"
                },
                {
                    "tip": "【1.1.1】叠加服装部件 遮掩名称取叠加衣物",
                    "passage": "Widgets Clothing caption text",
                    "findRegex": "<<faceintegrity>>\\s*\\$worn\\.face\\.(?:name|cn_name_cap)",
                    "regexFlag": "g",
                    "replace": "<<print DolOptimization.stackedTraitName(\"face\", \"mask\")>>"
                }
            ]
        },
        {
            "modName": "ReplacePatcher",
            "addonName": "ReplacePatcherAddon",
